      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Names given to the features when a device is added, titles of the movies, words sent to the scenes.",
        "fr": "Noms donnés aux fonctionnalités à l'ajout d'un appareil, titres des films, mots envoyés aux scènes.",
        "de": "Namen der Funktionen beim Hinzufügen eines Geräts, Filmtitel, an Szenen gesendete Wörter.",
        "es": "Nombres de las funciones al añadir un dispositivo, títulos de las películas, palabras enviadas a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
