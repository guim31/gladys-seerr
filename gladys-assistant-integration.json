  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads every server now and reports what it finds.",
        "fr": "Lit chaque serveur maintenant et indique ce qu’il trouve.",
        "de": "Liest jeden Server jetzt und meldet, was er findet.",
        "es": "Lee cada servidor ahora e indica lo que encuentra."
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "request_created",
      "label": {
        "en": "New request",
        "fr": "Nouvelle demande",
        "de": "Neue Anfrage",
        "es": "Nueva solicitud"
      },
      "description": {
        "en": "Someone requested a movie or a series, awaiting approval or approved at once.",
        "fr": "Quelqu'un a demandé un film ou une série, en attente d'approbation ou approuvé d'office.",
        "de": "Jemand hat einen Film oder eine Serie angefragt, wartend auf Freigabe oder sofort freigegeben.",
        "es": "Alguien ha solicitado una película o una serie, pendiente de aprobación o aprobada directamente."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Server (empty: any)",
            "fr": "Serveur (vide : tous)",
            "de": "Server (leer: alle)",
            "es": "Servidor (vacío: todos)"
          }
        },
        {
          "key": "media_type",
