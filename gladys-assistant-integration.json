{
  "manifest_version": 1,
  "type": "device",
  "name": "Overseerr / Jellyseerr",
  "description": {
    "en": "Movie and series requests of Overseerr, Jellyseerr or Seerr: approvals, arrivals, issues.",
    "fr": "Demandes de films et séries Overseerr, Jellyseerr ou Seerr : approbations, arrivées, problèmes.",
    "de": "Film- und Serienanfragen von Overseerr, Jellyseerr oder Seerr: Freigaben, Eingänge, Probleme.",
    "es": "Solicitudes de películas y series de Overseerr, Jellyseerr o Seerr: aprobaciones, llegadas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-seerr:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-seerr/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "server_1",
      "type": "section",
      "label": {
        "en": "Overseerr / Jellyseerr",
        "fr": "Overseerr / Jellyseerr",
        "de": "Overseerr / Jellyseerr",
        "es": "Overseerr / Jellyseerr"
      },
      "description": {
        "en": "Address and API key of your Overseerr, Jellyseerr or Seerr (Settings → General → API Key).",
        "fr": "Adresse et clé d'API de votre Overseerr, Jellyseerr ou Seerr (Settings → General → API Key).",
        "de": "Adresse und API-Schlüssel deines Overseerr, Jellyseerr oder Seerr (Settings → General → API Key).",
        "es": "Dirección y clave de API de su Overseerr, Jellyseerr o Seerr (Settings → General → API Key)."
      },
      "links": [
        {
          "url": "https://docs.overseerr.dev/using-overseerr/settings",
          "label": {
            "en": "Where to find the API key",
            "fr": "Où trouver la clé d'API",
            "de": "Wo du den API-Schlüssel findest",
            "es": "Dónde encontrar la clave de API"
          }
        }
      ]
    },
    {
      "key": "server_1_url",
      "type": "string",
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "de": "Adresse",
        "es": "Dirección"
      },
      "description": {
        "en": "IP address or name with the port, and the URL base if any (e.g. http://192.168.1.2:5055).",
        "fr": "Adresse IP ou nom avec le port, et la base d'URL s'il y en a une (ex. http://192.168.1.2:5055).",
        "de": "IP-Adresse oder Name mit Port und ggf. URL-Basis (z. B. http://192.168.1.2:5055).",
        "es": "Dirección IP o nombre con el puerto, y la base de URL si la hay (p. ej. http://192.168.1.2:5055)."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.2:5055",
        "fr": "ex. 192.168.1.2:5055",
        "de": "z. B. 192.168.1.2:5055",
        "es": "p. ej. 192.168.1.2:5055"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "server_1_api_key",
      "type": "secret",
      "label": {
        "en": "API key",
        "fr": "Clé d'API",
        "de": "API-Schlüssel",
        "es": "Clave de API"
      },
      "description": {
        "en": "Settings → General → API Key. It acts as the administrator of the server.",
        "fr": "Settings → General → API Key. Elle agit comme l'administrateur du serveur.",
        "de": "Settings → General → API Key. Er handelt als Administrator des Servers.",
        "es": "Settings → General → API Key. Actúa como el administrador del servidor."
      },
      "required": false
    },
    {
      "key": "server_1_name",
      "type": "string",
      "label": {
        "en": "Name",
        "fr": "Nom",
        "de": "Name",
        "es": "Nombre"
      },
      "description": {
        "en": "Name of the device in Gladys. Empty: the name of the application followed by the address.",
        "fr": "Nom de l'appareil dans Gladys. Vide : le nom de l'application suivi de l'adresse.",
        "de": "Name des Geräts in Gladys. Leer: der Name der Anwendung, gefolgt von der Adresse.",
        "es": "Nombre del dispositivo en Gladys. Vacío: el nombre de la aplicación seguido de la dirección."
      },
      "placeholder": {
        "en": "e.g. Jellyseerr",
        "fr": "ex. Jellyseerr",
        "de": "z. B. Jellyseerr",
        "es": "p. ej. Jellyseerr"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "server_2",
      "type": "section",
      "label": {
        "en": "Second server (optional)",
        "fr": "Second serveur (facultatif)",
        "de": "Zweiter Server (optional)",
        "es": "Segundo servidor (opcional)"
      },
      "description": {
        "en": "Same fields, for another server (a 4K instance, a Jellyseerr next to an Overseerr…).",
        "fr": "Mêmes champs, pour un autre serveur (une instance 4K, un Jellyseerr à côté d’un Overseerr…).",
        "de": "Dieselben Felder für einen weiteren Server (eine 4K-Instanz, ein Jellyseerr neben einem Overseerr…).",
        "es": "Los mismos campos, para otro servidor (una instancia 4K, un Jellyseerr junto a un Overseerr…)."
      }
    },
    {
