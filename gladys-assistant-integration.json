      "key": "server_2_api_key",
      "type": "secret",
      "label": {
        "en": "API key",
        "fr": "Clé d'API",
        "de": "API-Schlüssel",
        "es": "Clave de API"
      },
      "description": {
        "en": "Settings → General → API Key. It acts as the administrator of the server.",
        "fr": "Settings → General → API Key. Elle agit comme l'administrateur du serveur.",
        "de": "Settings → General → API Key. Er handelt als Administrator des Servers.",
        "es": "Settings → General → API Key. Actúa como el administrador del servidor."
      },
      "required": false
    },
    {
      "key": "server_2_name",
      "type": "string",
      "label": {
        "en": "Name",
        "fr": "Nom",
        "de": "Name",
        "es": "Nombre"
      },
      "description": {
        "en": "Name of the device in Gladys. Empty: the name of the application followed by the address.",
        "fr": "Nom de l'appareil dans Gladys. Vide : le nom de l'application suivi de l'adresse.",
        "de": "Name des Geräts in Gladys. Leer: der Name der Anwendung, gefolgt von der Adresse.",
        "es": "Nombre del dispositivo en Gladys. Vacío: el nombre de la aplicación seguido de la dirección."
      },
      "placeholder": {
        "en": "e.g. Jellyseerr",
        "fr": "ex. Jellyseerr",
        "de": "z. B. Jellyseerr",
        "es": "p. ej. Jellyseerr"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "allow_approval",
      "type": "boolean",
      "label": {
        "en": "Allow approving and declining",
        "fr": "Autoriser l'approbation et le refus",
        "de": "Freigeben und Ablehnen erlauben",
        "es": "Permitir aprobar y rechazar"
      },
      "description": {
        "en": "Lets scenes and the widget approve or decline the newest request awaiting approval. Off: Gladys only reads.",
        "fr": "Permet aux scènes et au widget d'approuver ou de refuser la dernière demande en attente. Décoché : Gladys ne fait que lire.",
        "de": "Erlaubt Szenen und dem Widget, die neueste wartende Anfrage freizugeben oder abzulehnen. Aus: Gladys liest nur.",
        "es": "Permite que las escenas y el widget aprueben o rechacen la última solicitud pendiente. Desactivado: Gladys solo lee."
      },
      "required": false,
      "default": false
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept self-signed certificates",
        "fr": "Accepter les certificats auto-signés",
        "de": "Selbstsignierte Zertifikate akzeptieren",
        "es": "Aceptar certificados autofirmados"
      },
      "description": {
        "en": "For https:// addresses served with your own certificate. Tick only for your own servers.",
        "fr": "Pour les adresses en https:// servies avec votre propre certificat. À cocher pour vos propres serveurs seulement.",
        "de": "Für https://-Adressen mit deinem eigenen Zertifikat. Nur für deine eigenen Server aktivieren.",
        "es": "Para direcciones https:// servidas con su propio certificado. Márquelo solo para sus propios servidores."
      },
      "required": false,
      "default": false
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often the servers are read: counters, new requests, arrivals, issues.",
        "fr": "Fréquence de lecture des serveurs : compteurs, nouvelles demandes, arrivées, problèmes.",
        "de": "Wie oft die Server gelesen werden: Zähler, neue Anfragen, Eingänge, Probleme.",
        "es": "Con qué frecuencia se leen los servidores: contadores, nuevas solicitudes, llegadas, problemas."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "600",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        }
      ]
    },
    {
