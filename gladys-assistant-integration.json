          "options": [
            {
              "value": "pending",
              "label": {
                "en": "Awaiting approval",
                "fr": "En attente d'approbation",
                "de": "Wartet auf Freigabe",
                "es": "Pendiente de aprobación"
              }
            },
            {
              "value": "approved",
              "label": {
                "en": "Approved at once",
                "fr": "Approuvée d'office",
                "de": "Sofort freigegeben",
                "es": "Aprobada directamente"
              }
